@model PROmaderas.UI.Models.SetupPasswordViewModel
@{
    ViewData["Title"] = "Activar acceso";
    Layout = null;
}

<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - PROMADERAS</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <style>
            .setup-card {
                background: linear-gradient(145deg, #0B1B3A 0%, #122147 100%);
                border: 1px solid rgba(201,168,76,0.25);
                border-radius: 16px;
                box-shadow: 0 30px 80px rgba(0,0,0,0.45);
            }

                .setup-card .form-control {
                    background: rgba(255,255,255,0.07);
                    border: 1px solid rgba(201,168,76,0.2);
                    color: #fff;
                }

                    .setup-card .form-control:focus {
                        background: rgba(255,255,255,0.12);
                        border-color: rgba(201,168,76,0.6);
                        color: #fff;
                        box-shadow: 0 0 0 0.2rem rgba(201,168,76,0.15);
                    }

                    .setup-card .form-control:disabled {
                        background: rgba(255,255,255,0.04);
                        color: rgba(255,255,255,0.5);
                    }

                .setup-card .form-label {
                    color: rgba(255,255,255,0.75);
                    font-size: 13px;
                    letter-spacing: 0.5px;
                }

                .setup-card h3 {
                    font-family: 'Playfair Display', serif;
                    color: #fff;
                    font-weight: 700;
                }

                .setup-card .text-muted {
                    color: rgba(255,255,255,0.55) !important;
                }

                .setup-card .text-danger {
                    color: #ff7b7b !important;
                }

            .btn-setup-submit {
                background: linear-gradient(135deg, rgba(201,168,76,1) 0%, rgba(180,148,56,1) 100%);
                border: none;
                color: #0B1B3A;
                font-weight: 700;
                padding: 12px;
                border-radius: 10px;
                letter-spacing: 0.5px;
            }

                .btn-setup-submit:hover {
                    background: linear-gradient(135deg, rgba(220,185,90,1) 0%, rgba(201,168,76,1) 100%);
                    color: #0B1B3A;
                }

            .btn-setup-back {
                background: transparent;
                border: 1px solid rgba(255,255,255,0.2);
                color: rgba(255,255,255,0.65);
                padding: 10px;
                border-radius: 10px;
            }

                .btn-setup-back:hover {
                    border-color: rgba(201,168,76,0.5);
                    color: rgba(201,168,76,1);
                }

            .setup-accent {
                display: block;
                width: 48px;
                height: 3px;
                background: rgba(201,168,76,1);
                border-radius: 2px;
                margin-bottom: 1.5rem;
            }
    </style>
</head>
<body class="promaderas-login-bg d-flex align-items-center min-vh-100">
    <div class="container py-5">
        <div class="row justify-content-center">
            <div class="col-lg-5 col-md-7">
                <div class="text-center mb-4">
                    <span class="fw-bold text-white" style="font-size:1.2rem; letter-spacing:1px;">PROMADERAS</span>
                </div>
                <div class="setup-card p-4 p-lg-5">
                    <span class="setup-accent"></span>
                    <h3 class="mb-1">Definir contrasena</h3>
                    <p class="text-muted mb-4">Configura tu acceso interno a PROmaderas.</p>

                    <form asp-action="SetupPassword" method="post">
                        @Html.AntiForgeryToken()
                        <input asp-for="Email" type="hidden" />
                        <input asp-for="Token" type="hidden" />

                        <div asp-validation-summary="ModelOnly" class="alert alert-danger mb-3"></div>

                        <div class="mb-3">
                            <label class="form-label">CORREO</label>
                            <input class="form-control" value="@Model.Email" disabled />
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
                        </div>

                        <div class="d-grid gap-2">
                            <button type="submit" class="btn btn-setup-submit">
                                <i class="bi bi-shield-lock me-2"></i>Guardar contrasena
                            </button>
                            <a asp-controller="Account" asp-action="Login" class="btn btn-setup-back text-center">
                                <i class="bi bi-arrow-left me-2"></i>Volver al login
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>

    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/jquery-validation/dist/jquery.validate.min.js"></script>
    <script src="~/lib/jquery-validation-unobtrusive/jquery.validate.unobtrusive.min.js"></script>
</body>
</html>