@using PROmaderas.Abstracciones.Models
@model DeduccionInternaAD
@{
    ViewData["Title"] = "Nueva deducción";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6">

            <div class="d-flex align-items-center mb-4">
                <a asp-action="Index" class="btn btn-outline-secondary me-3">
                    <i class="bi bi-arrow-left"></i>
                </a>
                <div>
                    <h1 class="h3 mb-0">
                        <i class="bi bi-scissors me-2" style="color:#c9a84c"></i>Nueva deducción
                    </h1>
                    <p class="text-muted mb-0 small">Define el nombre, tipo y valor de la deducción interna.</p>
                </div>
            </div>

            @if (TempData["ErrorMessage"] != null)
            {
                <div class="alert alert-warning alert-dismissible fade show mb-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>@TempData["ErrorMessage"]
                    <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                </div>
            }

            <div class="card shadow-sm">
                <div class="card-header" style="background:rgba(201,168,76,0.12);border-bottom:1px solid rgba(201,168,76,0.25);">
                    <strong><i class="bi bi-pencil-square me-2"></i>Datos de la deducción</strong>
                </div>
                <div class="card-body p-4">
                    <form asp-action="Create" method="post">
                        @Html.AntiForgeryToken()
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                        <div class="mb-3">
                            <label asp-for="Nombre" class="form-label fw-semibold"></label>
                            <input asp-for="Nombre" class="form-control" placeholder="Ej: Préstamo empresa, Cuota cooperativa…" required />
                            <span asp-validation-for="Nombre" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label class="form-label fw-semibold">Tipo de deducción</label>
                            <select asp-for="EsPorcentaje" class="form-select" id="tipoSelect">
                                <option value="false">Monto fijo (₡)</option>
                                <option value="true">Porcentaje del salario bruto (%)</option>
                            </select>
                        </div>

                        <div class="mb-3" id="campoMonto">
                            <label asp-for="Monto" class="form-label fw-semibold">Monto (₡)</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input asp-for="Monto" type="number" step="0.01" min="0"
                                       class="form-control" placeholder="0.00" />
                            </div>
                            <span asp-validation-for="Monto" class="text-danger small"></span>
                        </div>

                        <div class="mb-3 d-none" id="campoPorcentaje">
                            <label asp-for="Porcentaje" class="form-label fw-semibold">Porcentaje (%)</label>
                            <div class="input-group">
                                <input asp-for="Porcentaje" type="number" step="0.01" min="0" max="100"
                                       class="form-control" placeholder="0.00" />
                                <span class="input-group-text">%</span>
                            </div>
                            <span asp-validation-for="Porcentaje" class="text-danger small"></span>
                        </div>

                        <div class="mb-4 p-3 rounded" style="background:rgba(255,255,255,0.04);border:1px solid rgba(255,255,255,0.08);">
                            <div class="form-check">
                                <input asp-for="Activa" class="form-check-input" type="checkbox" value="true" checked />
                                <label class="form-check-label fw-semibold" asp-for="Activa">
                                    Deducción activa
                                </label>
                            </div>
                            <div class="text-muted small mt-1">
                                Solo las deducciones activas pueden asignarse a empleados.
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2">
                            <a asp-action="Index" class="btn btn-outline-secondary">Cancelar</a>
                            <button type="submit" class="btn btn-warning fw-bold px-4">
                                <i class="bi bi-floppy me-1"></i>Guardar deducción
                            </button>
                        </div>
                    </form>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        var sel = document.getElementById('tipoSelect');
        var campoMonto = document.getElementById('campoMonto');
        var campoPorcentaje = document.getElementById('campoPorcentaje');
        function toggle() {
            var esPorcentaje = sel.value === 'true';
            campoMonto.classList.toggle('d-none', esPorcentaje);
            campoPorcentaje.classList.toggle('d-none', !esPorcentaje);
        }
        sel.addEventListener('change', toggle);
        toggle();
    </script>
}