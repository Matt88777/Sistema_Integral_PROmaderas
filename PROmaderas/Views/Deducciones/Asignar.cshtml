@using PROmaderas.Abstracciones.Models
@model List<EmpleadoDeduccionAD>
@{
    ViewData["Title"] = "Deducciones del empleado";
    var empleado = ViewBag.Empleado as EmpleadoAD;
    var disponibles = ViewBag.Disponibles as List<DeduccionInternaAD> ?? new List<DeduccionInternaAD>();
}

<div class="container mt-4">
    <div class="row mb-4 align-items-center">
        <div class="col">
            <h2 class="mb-0">
                <i class="bi bi-person-gear me-2" style="color:#c9a03c"></i>
                Deducciones — @empleado?.Nombre @empleado?.PrimerApellido
            </h2>
            <p class="text-muted mb-0 mt-1">Asignaciones de deducciones para este empleado.</p>
        </div>
        <div class="col-auto d-flex gap-2">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-scissors me-1"></i>Catálogo de deducciones
            </a>
            <a asp-controller="Empleados" asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver a empleados
            </a>
        </div>

    @if (disponibles.Any())
    {
        <div class="card mb-4">
            <div class="card-body">
                <h5 class="card-title mb-3">
                    <i class="bi bi-plus-circle me-2" style="color:#c9a03c"></i>Agregar deducción
                </h5>
                <form asp-action="AsignarDeduccion" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="idEmpleado" value="@empleado?.IdEmpleado" />
                    <div class="row g-3 align-items-end">
                        <div class="col-md-5">
                            <label class="form-label mb-1">Deducción</label>
                            <select name="idDeduccion" class="form-select" required>
                                <option value="">Seleccione...</option>
                                @foreach (var d in disponibles)
                                {
                                    <option value="@d.IdDeduccion">
                                        @d.Nombre — @(d.EsPorcentaje ? $"{d.Porcentaje}%" : d.Monto?.ToString("C2"))
                                    </option>
                                }
                            </select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label mb-1">Monto total adeudado</label>
                            <div class="input-group">
                                <span class="input-group-text">₡</span>
                                <input type="number" name="montoTotal" class="form-control"
                                       step="0.01" min="0" placeholder="0.00" />
                            </div>
                        </div>
                        <div class="col-md-2">
                            <label class="form-label mb-1">Cuotas</label>
                            <input type="number" name="numeroCuotas" class="form-control"
                                   min="1" max="999" placeholder="Vacío = permanente" />
                        </div>
                        <div class="col-md-2">
                            <button type="submit" class="btn btn-warning fw-bold w-100">
                                <i class="bi bi-plus-circle me-1"></i>Asignar
                            </button>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    }
    else
    {
        <div class="alert alert-info mb-4">
            <i class="bi bi-info-circle me-2"></i>
            Todas las deducciones ya están asignadas a este empleado, o no hay deducciones activas configuradas.
            <a asp-action="Index" class="alert-link ms-1">Administrar catálogo de deducciones</a>
        </div>
    }

    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Deducción</th>
                    <th>Tipo</th>
                    <th>Valor por planilla</th>
                    <th>Total adeudado</th>
                    <th>Cuotas</th>
                    <th class="text-center">Quitar</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var a in Model)
                {
                    <tr>
                        <td class="fw-semibold">@a.Deduccion?.Nombre</td>
                        <td>@(a.Deduccion?.EsPorcentaje == true ? "Porcentaje" : "Monto fijo")</td>
                        <td>
                            @if (a.Deduccion?.EsPorcentaje == true)
                            {
                                <span>@a.Deduccion.Porcentaje %</span>
                            }
                            else
                            {
                                <span>@a.Deduccion?.Monto?.ToString("C2")</span>
                            }
                        </td>
                        <td>
                            @if (a.MontoTotal.HasValue)
                            {
                                <span>@a.MontoTotal.Value.ToString("C2")</span>
                            }
                            else
                            {
                                <span class="text-muted">—</span>
                            }
                        </td>
                        <td>
                            @if (a.NumeroCuotas.HasValue)
                            {
                                <span class="badge bg-info text-dark">@a.NumeroCuotas cuotas</span>
                            }
                            else
                            {
                                <span class="text-muted">Permanente</span>
                            }
                        </td>
                        <td class="text-center">
                            <form asp-action="Desasignar" method="post" class="d-inline m-0">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="idEmpleadoDeduccion" value="@a.IdEmpleadoDeduccion" />
                                <input type="hidden" name="idEmpleado" value="@empleado?.IdEmpleado" />
                                <button type="submit" class="btn btn-sm btn-accion-eliminar" title="Quitar">
                                    <i class="bi bi-x-lg"></i>
                                </button>
                            </form>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center text-muted py-4">
                            <i class="bi bi-inbox me-1"></i>Sin deducciones asignadas.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>