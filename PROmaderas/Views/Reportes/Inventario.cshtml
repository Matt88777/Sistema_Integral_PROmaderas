@model PROmaderas.UI.Models.ReporteInventarioViewModel

@{
    ViewData["Title"] = "Reporte de Inventario";
}

<div class="container mt-4">
    <div class="row mb-3 align-items-center">
        <div class="col">
            <h2><i class="bi bi-boxes me-2" style="color:#c9a03c"></i>Reporte de Inventario</h2>
            <p class="text-muted mb-0">Existencias actuales, movimientos de entradas/salidas y productos con bajo stock.</p>
        </div>
        <div class="col-auto">
            <a asp-action="Index" class="btn btn-outline-secondary">
                <i class="bi bi-arrow-left me-1"></i>Volver a Reportes
            </a>
        </div>
    </div>

    @if (!string.IsNullOrEmpty(Model.MensajeError))
    {
        <div class="alert alert-danger">
            <i class="bi bi-exclamation-triangle me-1"></i>@Model.MensajeError
        </div>
    }
    else if (Model.ConsultaRealizada && Model.Resultado is not null)
    {
        var resultado = Model.Resultado;

        @* Escenario 1: sin productos registrados *@
        @if (!resultado.HayExistencias)
        {
            <div class="alert alert-warning">
                <i class="bi bi-info-circle me-1"></i>
                No hay productos registrados para generar el reporte de existencias.
            </div>
        }
        else
        {
            <div class="row g-3 mb-4">
                <div class="col-md-4">
                    <div class="card shadow-sm text-center">
                        <div class="card-body">
                            <div class="text-white small">Productos registrados</div>
                            <div class="fs-3 fw-bold text-white">@resultado.TotalProductos</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm text-center" style="@(resultado.HayBajoStock ? "border-color:#dc3545;" : "")">
                        <div class="card-body">
                            <div class="text-white small">Productos con bajo stock</div>
                            <div class="fs-3 fw-bold @(resultado.HayBajoStock ? "text-danger" : "text-white")">@resultado.TotalBajoStock</div>
                        </div>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="card shadow-sm text-center">
                        <div class="card-body">
                            <div class="text-white small">Movimientos registrados</div>
                            <div class="fs-3 fw-bold text-white">@resultado.Movimientos.Count</div>
                        </div>
                    </div>
                </div>
            </div>

            @* Escenario 3: alerta de productos críticos *@
            @if (resultado.HayBajoStock)
            {
                <div class="alert alert-danger">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Hay <strong>@resultado.TotalBajoStock</strong> producto(s) con stock igual o por debajo del mínimo. Revise el detalle resaltado en la tabla.
                </div>
            }

            <!-- Escenario 1: Existencias actuales -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-clipboard-data me-1"></i>Existencias actuales
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-striped table-hover align-middle mb-0">
                            <thead class="table-dark">
                                <tr>
                                    <th>Código</th>
                                    <th>Tipo de Tarima</th>
                                    <th>Medida</th>
                                    <th class="text-end">Entradas</th>
                                    <th class="text-end">Salidas</th>
                                    <th class="text-end">Stock Actual</th>
                                    <th class="text-end">Stock Mínimo</th>
                                    <th>Estado</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var e in resultado.Existencias)
                                {
                                    bool bajoStock = e.StockActual <= e.StockMinimo;
                                    bool sinInventario = e.StockActual <= 0;

                                    <tr class="@(sinInventario ? "table-danger" : bajoStock ? "table-warning" : "")">
                                        <td>@e.Codigo</td>
                                        <td class="fw-semibold">@e.TipoTarima</td>
                                        <td>@e.Medida</td>
                                        <td class="text-end">@e.Entradas</td>
                                        <td class="text-end">@e.Salidas</td>
                                        <td class="text-end fw-bold">@e.StockActual</td>
                                        <td class="text-end">@e.StockMinimo</td>
                                        <td>
                                            @if (sinInventario)
                                            {
                                                <span class="badge bg-danger">Sin inventario</span>
                                            }
                                            else if (bajoStock)
                                            {
                                                <span class="badge bg-warning text-dark">Bajo mínimo</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-success">Disponible</span>
                                            }
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>

            <!-- Escenario 2: Movimientos de inventario -->
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-dark text-white">
                    <i class="bi bi-arrow-left-right me-1"></i>Movimientos de inventario (entradas y salidas)
                </div>
                <div class="card-body p-0">
                    @if (!resultado.HayMovimientos)
                    {
                        <div class="p-3 text-muted">
                            <i class="bi bi-info-circle me-1"></i>No hay movimientos de entrada o salida registrados.
                        </div>
                    }
                    else
                    {
                        <div class="table-responsive" style="max-height:400px;">
                            <table class="table table-striped table-hover align-middle mb-0">
                                <thead class="table-dark">
                                    <tr>
                                        <th>Fecha</th>
                                        <th>Código</th>
                                        <th>Tipo de Tarima</th>
                                        <th>Movimiento</th>
                                        <th class="text-end">Cantidad</th>
                                        <th class="text-end">Saldo</th>
                                        <th>Motivo</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (var m in resultado.Movimientos)
                                    {
                                        bool esEntrada = PROmaderas.Abstracciones.Catalogos.TiposMovimientoInventario.TiposEntrada.Contains(m.TipoMovimiento);

                                        <tr>
                                            <td class="text-nowrap">@m.FechaMovimiento.ToString("dd/MM/yyyy HH:mm")</td>
                                            <td>@m.Codigo</td>
                                            <td>@m.TipoTarima</td>
                                            <td>
                                                <span class="badge @(esEntrada ? "bg-success" : "bg-warning text-dark")">
                                                    @m.TipoMovimiento
                                                </span>
                                            </td>
                                            <td class="text-end">@m.Cantidad</td>
                                            <td class="text-end">@m.Saldo</td>
                                            <td class="text-muted small">@(m.Motivo ?? "—")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        </div>
                    }
                </div>
            </div>
        }

        <div class="d-flex gap-2 mb-4">
            <a class="btn btn-sm" style="background-color:#c9a03c;color:#1a1a2e;" asp-action="ExportarInventarioExcelAdmin">
                <i class="bi bi-file-earmark-excel me-1"></i>Excel
            </a>
            <a class="btn btn-sm btn-outline-secondary" asp-action="ExportarInventarioPdfAdmin">
                <i class="bi bi-file-earmark-pdf me-1"></i>PDF
            </a>
        </div>
    }
</div>
